# RelatAI backend configuration sample
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=25
PROFILE_SAMPLE_SIZE=5000
TEMP_STORAGE_PATH=datasets/uploads
CACHE_BACKEND=memory
DATASET_REGISTRY_MAX_ITEMS=100
DATASET_REGISTRY_STATE_PATH=datasets/registry.json

# Preprocessing configuration (Milestone 4)
# Missing value handling for numeric columns: median, mean, or zero
PREPROCESSING_MISSING_NUMERIC=median
# Missing value handling for categorical columns: mode or constant
PREPROCESSING_MISSING_CATEGORICAL=mode
# Constant value to use when PREPROCESSING_MISSING_CATEGORICAL=constant
PREPROCESSING_MISSING_CONSTANT=Unknown
# Outlier handling strategy: none or iqr_clip (IQR-based clipping)
PREPROCESSING_OUTLIER_STRATEGY=iqr_clip
# Scaling strategy: none or robust (robust scaling using median and IQR)
PREPROCESSING_SCALING_STRATEGY=robust
